{
  "name": "med-technique",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup": "node scripts/backup-restore.mjs backup",
    "restore": "node scripts/backup-restore.mjs restore",
    "seed:sql": "vitest run src/data/seed/generate-sql.test.ts",
    "docker:up": "docker compose -f docker/compose.yml up --build -d",
    "docker:down": "docker compose -f docker/compose.yml down",
    "docker:db": "docker compose -f docker/compose.yml --profile db up -d db"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/decimal.js": "^0.0.32",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/xlsx": "^0.0.35",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
