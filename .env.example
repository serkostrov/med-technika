# ── Application ──────────────────────────────────────────
# local | staging | production
VITE_APP_ENV=local

# Persist in-memory Database snapshot in sessionStorage (browser SPA mode).
# true  — удобно для локальной разработки (данные переживают refresh)
# false — обязательно для production SPA
VITE_PERSIST_LOCAL_DB=true

# ── Supabase (опционально) ───────────────────────────────
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
