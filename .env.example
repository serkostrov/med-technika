# ── Application ──────────────────────────────────────────
# local | staging | production
VITE_APP_ENV=local

# Persist in-memory Database snapshot in sessionStorage (browser SPA mode).
# true  — удобно для локальной разработки (данные переживают refresh)
# false — обязательно для production SPA до появления Postgres API
VITE_PERSIST_LOCAL_DB=true

# ── Postgres / Supabase (целевой сервер) ─────────────────
# Connection string for migrations, backup, future API
DATABASE_URL=postgresql://mt:change-me@127.0.0.1:5432/med_technique

# Supabase project (when using hosted or `supabase start`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Optional: object storage for files ───────────────────
# STORAGE_ENDPOINT=
# STORAGE_BUCKET_SOURCES=protocol-sources
# STORAGE_BUCKET_SCANS=protocol-scans
# STORAGE_BUCKET_EXPORTS=fgis-exports
