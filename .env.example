# ── Application ──────────────────────────────────────────
# local | staging | production
VITE_APP_ENV=local

# Режим клиента:
#   VITE_API_BASE=/api  — SPA ходит на Node-сервис, данные в Postgres (production)
#   пусто               — portable-режим, данные в IndexedDB браузера
VITE_API_BASE=

# Только portable-режим: сохранять снимок в IndexedDB (по умолчанию true)
VITE_PERSIST_LOCAL_DB=true

# ── Node-сервис (runtime, не VITE_*) ─────────────────────
# Postgres Supabase. Секрет — только в Dokploy Environment, не в git.
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres
# DATABASE_SSL=true
# PORT=80
# STATIC_DIR=dist
# Первая учётка начальника ИЛ (используется только на ПУСТОЙ базе)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Локально без Postgres: PGLITE_DIR=.data/pglite

# ── Supabase (опционально) ───────────────────────────────
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
