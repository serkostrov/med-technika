# ── Application ──────────────────────────────────────────
# local | staging | production
VITE_APP_ENV=local

# Persist in-memory Database в localStorage (справочники, протоколы).
# true  — рекомендуется для portable SPA (данные переживают logout/refresh)
# false — только если данные идут в настоящий Postgres API
VITE_PERSIST_LOCAL_DB=true

# ── Supabase (опционально) ───────────────────────────────
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
